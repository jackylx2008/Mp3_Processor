# 复制为 common.env 后按本机情况修改；common.env 不提交 Git。
LOG_LEVEL=INFO
INPUT_PATH=mp3_files/input
OUTPUT_DIR=output
FFMPEG_PATH=ffmpeg

# 跨平台 CloudStation 根目录；运行时会按当前系统自动选择。
# 显式设置 CLOUDSTATION_ROOT 时，它的优先级最高。
CLOUDSTATION_ROOT_WINDOWS=D:\CloudStaion
CLOUDSTATION_ROOT_MACOS=~/SynologyDrive
CLOUDSTATION_ROOT_LINUX=~/CloudStation

# 工作流覆盖示例。
CONVERT_BITRATE=192k
CONVERT_OUTPUT_TYPE=mp3
AUDIO_ARTIST=
AUDIO_ALBUM=
COVER_IMAGE=assets/cover_images/cover.png
