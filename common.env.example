# 复制为 common.env 后按本机情况修改；common.env 不提交 Git。
LOG_LEVEL=INFO
INPUT_PATH=mp3_files/input
OUTPUT_DIR=output

# 可选的跨平台 CloudStation 根目录。
CLOUDSTATION_ROOT_WINDOWS=D:\example\CloudStation
CLOUDSTATION_ROOT_MACOS=~/example/CloudStation
CLOUDSTATION_ROOT_LINUX=~/example/CloudStation

# 工作流覆盖示例。
CONVERT_BITRATE=192k
AUDIO_ARTIST=
AUDIO_ALBUM=
COVER_IMAGE=assets/cover_images/cover.png
